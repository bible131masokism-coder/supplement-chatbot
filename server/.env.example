# คัดลอกไฟล์นี้ไปเป็น .env แล้ววาง key + ตั้งค่า provider ของคุณ
# ใช้อย่างน้อย 1 ตัว: OPENAI_API_KEY (generic/OpenAI) หรือ DEEPSEEK_API_KEY
OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# base URL ของ API (OpenAI-compatible)
#   DeepSeek: https://api.deepseek.com
#   OpenAI:   https://api.openai.com/v1
#   อื่นๆ:     ตามที่ provider แจ้ง
API_BASE_URL=https://api.deepseek.com

# ชื่อโมเดล
#   DeepSeek: deepseek-chat
#   OpenAI:   gpt-4o-mini
OPENAI_MODEL=deepseek-chat
